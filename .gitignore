.venv/
__pycache__/
*.pyc
models/*.pt
models/*.joblib
frontend/node_modules/
frontend/dist/
frontend/.review/
frontend/**/*.tsbuildinfo
frontend/src/**/*.js
frontend/vite.config.js
frontend/vite.config.d.ts

# 注：.env 是故意入库的课程组共用密钥，4 个协作者 clone 即用。
#     一旦仓库转为 public、或密钥被滥用，立刻去 OpenAQ 后台轮换并更新本文件。
#     想换成自己的私钥：复制 .env 为 .env.local 再改 OPENAQ_API_KEY（.env.local 不入库）。
.env.local

# 本机缓存 / 本地配置，不入库
.pytest_cache/
.ruff_cache/
.claude/settings.local.json
.claude/launch.json

# ZCode 本地工作区配置
.zcode/
.zcodeignore

# 本地开发日志
data/*.log
# 运行时数据库：单文件已超 GitHub 100 MiB 上限，且每次采集都会变，入库必冲突
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/models/lstm_pm25_*.json
data/backups/

# 临时探测脚本 / 与本项目无关的本机工具
frontend/scripts/*.tmp.mjs
driver-backup/
net-diag.ps1
install-ax201-driver.ps1
