.venv/
__pycache__/
*.pyc
models/*.pt
models/*.joblib
frontend/node_modules/
frontend/dist/
frontend/.review/
frontend/**/*.tsbuildinfo
frontend/src/**/*.js
frontend/vite.config.js
frontend/vite.config.d.ts

# 密钥与本地配置，绝不入库
.env
.env.local

# 本机缓存 / 本地配置，不入库
.pytest_cache/
.ruff_cache/
.claude/settings.local.json
.claude/launch.json

# ZCode 本地工作区配置
.zcode/
.zcodeignore

# 本地开发日志
data/*.log
# 运行时数据库：单文件已超 GitHub 100 MiB 上限，且每次采集都会变，入库必冲突
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/models/lstm_pm25_*.json
data/backups/

# 临时探测脚本 / 与本项目无关的本机工具
frontend/scripts/*.tmp.mjs
driver-backup/
net-diag.ps1
install-ax201-driver.ps1
