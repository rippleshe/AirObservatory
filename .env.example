# 本地可选配置。数值都有默认值，**不建这个文件也能跑**：
#   - 平时用本地演示库（scripts/seed_demo），不需要任何密钥；
#   - 只有要采真实数据时才复制本文件为 .env，并填上自己的 OpenAQ 密钥。
# .env 不入库（.gitignore 已排除），密钥不会被提交。

# 只是要采真实数据时才需要：https://openaq.org 自己申请一个
OPENAQ_API_KEY=

# 运行时数据库路径（注意变量名是 DATABASE_PATH；旧示例里的 DB_PATH 不会被读取）
AIR_OBSERVATORY_DATABASE_PATH=data/air_observatory.db

AIR_OBSERVATORY_HTTP_TIMEOUT_SECONDS=30
AIR_OBSERVATORY_CAMS_REFRESH_SECONDS=900
AIR_OBSERVATORY_OPENAQ_REFRESH_SECONDS=300
AIR_OBSERVATORY_WEATHER_REFRESH_SECONDS=21600
AIR_OBSERVATORY_WEATHER_ARCHIVE_LAG_DAYS=5
AIR_OBSERVATORY_FORECAST_HOURS=24

# 仅当前端从别的域名直连本 API 时才需要，逗号分隔；同源部署或走 Vite 代理留空
AIR_OBSERVATORY_CORS_ORIGINS=
